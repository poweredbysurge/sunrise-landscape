# ─── Lead notifications (app/api/contact/route.ts) ───────────────────────────

# Resend API key. Platform-level key on Surge's Resend account (ADR-024).
# Without this the contact form returns 500 and no notification is sent.
RESEND_API_KEY=

# Sender for the INTERNAL new-lead alert. Seen only by Sunrise and Surge staff,
# so it ships on a Surge-verified domain. The default already points at the
# domain that IS verified in Surge's Resend account, so leave this unset unless
# you are moving the sender.
# Default: "Sunrise Website <leads@updates.thesurgeagency.com>"
LEAD_NOTIFY_FROM=

# Sender for the confirmation that goes to the LEAD. No default on purpose:
# this one is customer-facing, so per ADR-024 it must come from a verified
# Sunrise domain. Leave unset and the confirmation is skipped entirely.
# Set to e.g. "Sunrise Landscape & Design <hello@mail.sunriselandscapeanddesign.com>"
LEAD_REPLY_FROM=

# Recipients. Comma-separated. Both have working defaults in the route.
# Default To: mflickinger@sunriselandscapeanddesign.com
LEAD_NOTIFY_TO=
# Default Cc: manager@thesurgeagency.com,info@sunriselandscapeanddesign.com
LEAD_NOTIFY_CC=

# ─── Surge Command Center forwarding (lib/leads/commandCenter.ts) ────────────

# Public ingest token for the Sunrise tenant (ADR-025). UNSET = forwarding is
# dormant, which is the current state: no Sunrise tenant is provisioned yet.
# Setting this is the entire activation step.
SURGE_INGEST_TOKEN=

# Override only if the Command Center is not at its production host.
# Default: https://command.thesurgeagency.com/api/inbound/lead-form
SURGE_INGEST_URL=
